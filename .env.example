# Nyaxus daemon configuration, via environment variables.
#
# The daemon reads config from NYAXUS_* variables (or CLI flags - the
# environment is how a service deployment configures it, e.g. a systemd
# `EnvironmentFile=`); these are the variables `load_config` reads.
# Unset variables fall back to built-in defaults, so an empty file is a
# valid developer configuration.

# ── daemon ────────────────────────────────────────────────────────────────
# HTTP + SSE port (default 8787)
NYAXUS_PORT=
# Working directory for durable state (nyaxus.db, memory.db, spills);
# default "." (the daemon's cwd)
NYAXUS_WORKSPACE=
# Password gate for the API; empty = all routes open (single-host setups)
NYAXUS_PASSWORD=

# ── primary provider ──────────────────────────────────────────────────────
# Engine: "openai" (any OpenAI-compatible endpoint: llama.cpp, vLLM) or
# "fake" (built-in echo engine, default - no network needed)
NYAXUS_PROVIDER=
# Base URL of the OpenAI-compatible endpoint
NYAXUS_LLAMA_URL=
NYAXUS_MODEL=
# Bearer key sent to the endpoint (remote providers)
NYAXUS_API_KEY=
NYAXUS_TEMPERATURE=
NYAXUS_MAX_TOKENS=
# Connection-level capability overrides (unset = discovered from the endpoint)
NYAXUS_AUXILIARY_VISION=
NYAXUS_AUXILIARY_NO_THINKING=
# Name of the provider connection the UI's profile picker opens by default
NYAXUS_DEFAULT_PROVIDER=
# Dedicated fast model for conversation titles (empty = reuse the primary);
# NYAXUS_TITLE_ENABLED=0 turns the feature off
NYAXUS_TITLE_MODEL=

# ── auxiliary model (context compaction) ─────────────────────────────────
NYAXUS_AUXILIARY_URL=
NYAXUS_AUXILIARY_MODEL=
NYAXUS_AUXILIARY_API_KEY=
NYAXUS_AUXILIARY_TEMPERATURE=
NYAXUS_AUXILIARY_MAX_TOKENS=

# ── memory ────────────────────────────────────────────────────────────────
# Provider: "custom" (in-process bank, memory.db) or "hindsight" (HTTP
# service, default); NYAXUS_MEMORY_ENABLED=0 turns memory off entirely
NYAXUS_MEMORY_PROVIDER=
NYAXUS_MEMORY_URL=
NYAXUS_MEMORY_API_KEY=
NYAXUS_MEMORY_BANK=
# SQLite path for the custom bank (default beside the workspace db)
NYAXUS_MEMORY_DB_PATH=
NYAXUS_MEMORY_RETAIN_EVERY_N_TURNS=
NYAXUS_MEMORY_RECALL_FLOOR=
NYAXUS_MEMORY_SWEEP_COSINE_THRESHOLD=
NYAXUS_MEMORY_SWEEP_IDLE_SECONDS=
# Extraction and reranking model knobs for the custom provider
NYAXUS_MEMORY_EXTRACT_URL=
NYAXUS_MEMORY_EXTRACT_MODEL=
NYAXUS_MEMORY_EXTRACT_API_KEY=
NYAXUS_MEMORY_EMBED_MODEL=
NYAXUS_MEMORY_RERANK_MODEL=
NYAXUS_MEMORY_RERANK_TOP=
# Per-turn recall injection
NYAXUS_MEMORY_RECALL_ON_TURN=

# ── web research ────────────────────────────────────────────────────
# NYAXUS_WEB_ENABLED=0 removes the web tool set
NYAXUS_WEB_ENABLED=
# Native fetch tier
NYAXUS_WEB_CA_BUNDLE=
NYAXUS_WEB_FETCH_MAX_BYTES=
NYAXUS_WEB_FETCH_MAX_CHARS=
NYAXUS_WEB_FETCH_TIMEOUT_MS=
# Escalation tiers (Firecrawl, then a browser-render service)
NYAXUS_WEB_FIRECRAWL_ENDPOINT=
NYAXUS_WEB_SEARCH_ENDPOINT=
NYAXUS_WEB_CAMOFOX_ENDPOINT=
NYAXUS_WEB_CAMOFOX_TOKEN=

# ── summaries ─────────────────────────────────────────────────────
NYAXUS_SUMMARY_SOURCE_BUDGET_BYTES=
NYAXUS_SUMMARY_INCLUDE_REASONING=

# ── context management ────────────────────────────────────────
NYAXUS_CONTEXT_MICROCOMPACT=

# ── terminal execution ──────────────────────────────────────
NYAXUS_TERMINAL_READONLY_AUTO_APPROVE=
# Full terminal output as spill files (off = head/tail reduction only)
NYAXUS_TERMINAL_SPILL_FULL_OUTPUT=

# ── engine tuning and diagnostics (optional) ────────────────
# In-process Qwen3 engine worker threads
NYAXUS_ENGINE_THREADS=
# Render-layer caps and diagnostics: NYAXUS_NO_AVX2=1 disables the AVX2
# kernels; NYAXUS_LOG_LEVEL controls log verbosity; NYAXUS_DEBUG_LAYERS
# and NYAXUS_MEM_TIMING are developer diagnostics.
# NYAXUS_LOG_LEVEL=
# NYAXUS_NO_AVX2=
# NYAXUS_DEBUG_LAYERS=
# NYAXUS_MEM_TIMING=
